{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "git clone https://github.com/flutter/flutter.git --depth 1 --branch 3.35.1 .flutter-sdk && .flutter-sdk/bin/flutter --disable-analytics && .flutter-sdk/bin/flutter pub get",
  "buildCommand": ".flutter-sdk/bin/flutter build web --release --wasm --pwa-strategy=none",
  "outputDirectory": "build/web",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
